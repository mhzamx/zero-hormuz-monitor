		displayFolder: 7 Por que no reemplazan
		lineageTag: 4e71640f-f943-42bf-83f2-610931771d06

	measure 'Participacion Fujairah %' = DIVIDE ( CALCULATE ( [Toneladas (Mt)], dim_puerto[puerto] = "Fujairah" ), CALCULATE ( [Toneladas (Mt)], dim_puerto[puerto] = "Fujairah", ALL ( dim_segmento ) ) )
		formatString: 0%
		displayFolder: 7 Por que no reemplazan
		lineageTag: ad7773b5-124e-4109-a40b-c2b2a6e1d177

	measure 'MSO (kt/sem)' = DIVIDE ( SUM ( mso_puertos[mso_t_semana] ), 1000 )
		formatString: #,0.0
		displayFolder: 3 Indicadores
		lineageTag: c5676ce4-1349-4922-891c-44543c1eaa51

	measure 'Alertas (n)' = COUNTROWS ( alertas )
		formatString: #,0
		displayFolder: 6 Metodo
		lineageTag: 4ac1c8df-65ef-4a39-a848-f73c59461076

	column Columna1
