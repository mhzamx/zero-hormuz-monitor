table _Medidas
	lineageTag: a1766613-87a3-4779-8ef1-5b47913bb458

	measure 'Toneladas (Mt)' = DIVIDE ( SUM ( fact_puerto_diario[toneladas] ), 1000000 )
		formatString: #,0.0
		displayFolder: 1 Volumen
		lineageTag: 61874265-20ef-4d52-a514-da3803d4a5da

	measure 'Referencia M3 (Mt)' = DIVIDE ( SUM ( fact_puerto_diario[ref_M3_t] ), 1000000 )
		formatString: #,0.0
		displayFolder: 1 Volumen
		lineageTag: a201cfe2-9663-46eb-bd87-133caadca64f

	measure 'Referencia M1 (Mt)' = DIVIDE ( SUM ( fact_puerto_diario[ref_M1_t] ), 1000000 )
		formatString: #,0.0
		displayFolder: 1 Volumen
		lineageTag: 24d52d69-9f8c-4feb-9cd6-2f2d7baf5a5b

	measure 'Referencia M4 (Mt)' = DIVIDE ( SUM ( fact_puerto_diario[ref_M4_t] ), 1000000 )
		formatString: #,0.0
		displayFolder: 1 Volumen
		lineageTag: 998f83e2-60c7-453d-b190-afa10470f708

	measure 'Indice vs referencia' = DIVIDE ( [Toneladas (Mt)], [Referencia M3 (Mt)] )
		formatString: 0.00
		displayFolder: 1 Volumen
		lineageTag: 722729b4-c141-4870-af04-2dc610e0a5b4

	measure 'Golfo actual (Mt)' = CALCULATE ( [Toneladas (Mt)], dim_puerto[grupo] = "Golfo EAU" )
		formatString: #,0.0
		displayFolder: 2 Grupos
		lineageTag: 0525e344-f986-4c84-8368-698b490bc0c2

	measure 'Golfo referencia (Mt)' = CALCULATE ( [Referencia M3 (Mt)], dim_puerto[grupo] = "Golfo EAU" )
		formatString: #,0.0
		displayFolder: 2 Grupos
		lineageTag: f203fc09-144d-4e55-911f-2472db60c224

	measure 'Costa este actual (Mt)' = CALCULATE ( [Toneladas (Mt)], dim_puerto[grupo] = "Costa este EAU" )
		formatString: #,0.0
		displayFolder: 2 Grupos
		lineageTag: 07402e55-74ad-4e5d-bcb6-f93da2542fb0

	measure 'Costa este referencia (Mt)' = CALCULATE ( [Referencia M3 (Mt)], dim_puerto[grupo] = "Costa este EAU" )
		formatString: #,0.0
		displayFolder: 2 Grupos
		lineageTag: f789edc1-f301-4f72-b405-e0ee67b3aa7d

	measure 'Oman actual (Mt)' = CALCULATE ( [Toneladas (Mt)], dim_puerto[grupo] = "Omán" )
		formatString: #,0.0
		displayFolder: 2 Grupos
		lineageTag: 85447007-7117-4923-ad6a-59995900c774

	measure 'Oman referencia (Mt)' = CALCULATE ( [Referencia M3 (Mt)], dim_puerto[grupo] = "Omán" )
		formatString: #,0.0
		displayFolder: 2 Grupos
		lineageTag: 8c412078-6d42-481f-876c-ecb06b2489a6

	measure 'Actividad preservada %' = DIVIDE ( [Golfo actual (Mt)] + [Costa este actual (Mt)], [Golfo referencia (Mt)] + [Costa este referencia (Mt)] )
		formatString: 0.0%
		displayFolder: 3 Indicadores
		lineageTag: 9b73327d-1674-4fcf-ac81-fc6382c4ac29

	measure 'Perdida del Golfo (Mt)' = [Golfo referencia (Mt)] - [Golfo actual (Mt)]
		formatString: #,0.0
		displayFolder: 3 Indicadores
		lineageTag: c0dedbb0-791d-4024-8ae7-68b10debc889

	measure 'Cambio costa este (Mt)' = [Costa este actual (Mt)] - [Costa este referencia (Mt)]
		formatString: #,0.0
		displayFolder: 3 Indicadores
		lineageTag: 0f13b29a-d420-41be-8254-562e55b21472

	measure 'Compensacion costa este (Mt)' = MAX ( 0, [Cambio costa este (Mt)] )
		formatString: #,0.0
		displayFolder: 3 Indicadores
		lineageTag: f8047ad6-9dc2-4725-8d69-653e0a5f7876

	measure 'Perdida propia costa este (Mt)' = MAX ( 0, - [Cambio costa este (Mt)] )
		formatString: #,0.0
		displayFolder: 3 Indicadores
		lineageTag: e2620044-22e4-4a5d-9dc7-023daf90d731

	measure 'Brecha residual (Mt)' = [Perdida del Golfo (Mt)] - [Cambio costa este (Mt)]
		formatString: #,0.0
		displayFolder: 3 Indicadores
		lineageTag: 06a90e4e-eca8-48e4-9443-a2f80e35b7d0

	measure 'IDO actual %' = DIVIDE ( [Golfo actual (Mt)], [Golfo actual (Mt)] + [Costa este actual (Mt)] )
		formatString: 0.0%
		displayFolder: 3 Indicadores
		lineageTag: 59e3788f-63f4-47ee-8197-020b474bdc36

	measure 'IDO referencia %' = DIVIDE ( [Golfo referencia (Mt)], [Golfo referencia (Mt)] + [Costa este referencia (Mt)] )
		formatString: 0.0%
		displayFolder: 3 Indicadores
		lineageTag: e308e752-9b36-4a02-8d02-7bdcd12ad075

	measure Escalas = SUM ( fact_puerto_diario[escalas] )
		formatString: #,0
		displayFolder: 3 Indicadores
		lineageTag: a9bb785e-8328-4eaf-abf3-309b7c14b9bb

	measure 'Escalas referencia M3' = SUM ( fact_puerto_diario[ref_M3_escalas] )
		formatString: #,0
		displayFolder: 3 Indicadores
		lineageTag: 5ba17344-2a2f-48d8-85cb-9b25f67bd9ac

	measure 'Transitos Ormuz' = SUM ( fact_ormuz_diario[transitos_total] )
		formatString: #,0
		displayFolder: 4 Ormuz
		lineageTag: b739b720-49d8-4ac6-b019-8772f0a987b0

	measure 'Transitos Ormuz referencia M3' = SUM ( fact_ormuz_diario[ref_M3_transitos] )
		formatString: #,0
		displayFolder: 4 Ormuz
		lineageTag: 4e838055-1792-4da4-84f3-79d3aed4180e

	measure 'Transitos vs referencia %' = DIVIDE ( [Transitos Ormuz], [Transitos Ormuz referencia M3] )
		formatString: 0.0%
		displayFolder: 4 Ormuz
		lineageTag: e915eec2-d460-4634-87e9-8e9575860772

	measure 'Preservada M3 resumen %' = IF ( HASONEVALUE ( dim_segmento_resumen[segmento] ), DIVIDE ( CALCULATE ( SUM ( resumen_acumulado[preservada_pct] ), resumen_acumulado[referencia] = "M3" ), 100 ) )
		formatString: 0.0%
		displayFolder: 5 Resumen
		lineageTag: 168c985c-cfc6-4ea6-a529-ceb078612b95

	measure 'Rango sensibilidad M1-M5' = IF ( HASONEVALUE ( dim_segmento_resumen[segmento] ), FORMAT ( MIN ( resumen_acumulado[preservada_pct] ) / 100, "0.0%", "en-US" ) & " a " & FORMAT ( MAX ( resumen_acumulado[preservada_pct] ) / 100, "0.0%", "en-US" ), "Elige un segmento" )
		displayFolder: 5 Resumen
		lineageTag: 9ea14685-5eab-4ceb-9b1c-a4d7b6bb7392

	measure 'Brecha residual M3 resumen (Mt)' = IF ( HASONEVALUE ( dim_segmento_resumen[segmento] ), CALCULATE ( SUM ( resumen_acumulado[d_brecha_residual_Mt] ), resumen_acumulado[referencia] = "M3" ) )
		formatString: #,0.0
		displayFolder: 5 Resumen
		lineageTag: 10fd0e8e-43fa-455d-8acc-df640357054d

	measure 'Cambio costa este M3 resumen (Mt)' = IF ( HASONEVALUE ( dim_segmento_resumen[segmento] ), CALCULATE ( SUM ( resumen_acumulado[b_compensacion_este_Mt] ) - SUM ( resumen_acumulado[b_perdida_propia_este_Mt] ), resumen_acumulado[referencia] = "M3" ) )
		formatString: +#,0.0;-#,0.0;0.0
		displayFolder: 5 Resumen
		lineageTag: 777dab07-9870-4e68-a481-c71ebe9cfd0b

	measure 'Titulo resumen' = "Actividad preservada, " & SELECTEDVALUE ( dim_segmento_resumen[segmento], "elige un segmento" ) & ": " & FORMAT ( [Preservada M3 resumen %], "0.0%", "en-US" ) & " de la referencia M3 (1 mar a 25 sep 2026)"
		displayFolder: 5 Resumen
		lineageTag: 924cbc4b-caf4-45b1-aeb5-769e9eac3a7f

	measure 'WAPE mediano' = MEDIAN ( backtest_wape[WAPE_pct] )
		formatString: 0.0
		displayFolder: 6 Metodo
		lineageTag: b9fea70e-c0f6-40e2-8b82-99b77cbc9cdc

	measure 'KF contenedores (kt)' = SUM ( porque_semanal[khor_fakkan_cont_kt] )
