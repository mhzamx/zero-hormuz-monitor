		lineageTag: c0ef06df-91d2-483f-b3ce-3b4c559657c9
		summarizeBy: none

	column 'Periodo comparación' = SWITCH ( TRUE (), dim_fecha[Día] >= DATE ( 2026, 3, 1 ) && dim_fecha[Día] <= DATE ( 2026, 9, 25 ), "2026 (cierre)", dim_fecha[Día] >= DATE ( 2025, 3, 1 ) && dim_fecha[Día] <= DATE ( 2025, 9, 25 ), "2025 (normal)", BLANK () )
		dataType: string
		lineageTag: 8bc5ea5d-baef-4885-a98d-74c54d941a5e
		summarizeBy: none

	partition dim_fecha = m
		mode: import
		source =
